<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Installs APKs for the other apps here (Delta, Updater) without the system
         installer's screen, which on the XP3 refuses anything not signed by
         Sonim or on Sonim's Scout whitelist. That only works because this app
         is the device owner; see README.md. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Only an app signed with the same key as this one may call
         InstallActivity. The install itself is this app's own privilege. -->
    <permission
        android:name="com.installer.xp3.permission.INSTALL"
        android:protectionLevel="signature" />
    <!-- Held too, so the install outcome, sent as this app, passes the same
         check when it comes back (InstallActivity's receiver requires it). -->
    <uses-permission android:name="com.installer.xp3.permission.INSTALL" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Says whether this app is the device owner. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Started for a result with an APK's content URI. Exported so Delta
             and the Updater can reach it, but guarded by the signature
             permission above, so only an app with the shared key can call
             it. -->
        <activity
            android:name=".InstallActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:theme="@style/Invisible"
            android:excludeFromRecents="true"
            android:permission="com.installer.xp3.permission.INSTALL"
            android:exported="true" />

        <receiver
            android:name=".Admin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
