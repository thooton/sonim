<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Chrome is a deep teal, so Delta reads as its own app beside Charge's
         navy and Canvas's maroon. It is a band across the top of every
         screen, so it sits back rather than shouts, and the darker shade gives
         white tab labels the contrast a small screen read outdoors needs. -->
    <color name="primary">#0F4C4C</color>
    <color name="primary_dark">#0A3434</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#8FB8B8</color>

    <color name="page">#FAFAFA</color>
    <color name="row">#FFFFFF</color>
    <color name="section_fill">#EFEFEF</color>
    <color name="divider">#DCDCDC</color>

    <!-- Focus is the one place colour is allowed to be assertive, and even
         there it is a 2dp rule and a pale wash rather than a filled block. -->
    <color name="focus_fill">#E3EFEF</color>
    <color name="focus_rule">#0F4C4C</color>
    <color name="press_fill">#CDE2E2</color>

    <color name="text">#1A1A1A</color>
    <color name="text_muted">#6E6E6E</color>
    <!-- The value column: "Working", "On phone". Teal like the chrome, so it
         reads as the app's own word about the row rather than as part of it. -->
    <color name="accent_text">#0F6363</color>

    <!-- The transcript: grey for you, white for Claude. -->
    <color name="chat_page">#FFFFFF</color>
    <color name="bubble_you">#E6E6E6</color>
    <color name="bubble_agent">#FFFFFF</color>
    <color name="code_fill">#F0F0F0</color>

    <!-- Read off the stock Messages compose field: 85% black text, 50% black
         hint, and the same 50% black in the 3dp rule around the box. -->
    <color name="input_text">#D8000000</color>
    <color name="input_hint">#7F000000</color>
    <color name="input_border">#7F000000</color>
</resources>
