<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Measured against the XP3's 240x320 mdpi panel: 24dp status bar and a
         36dp tab bar leave 260dp of content. -->
    <dimen name="tab_bar_height">36dp</dimen>
    <dimen name="tab_underline">3dp</dimen>
    <dimen name="tab_text">13sp</dimen>

    <!-- Two lines and a value: five rows fit under the tab bar. -->
    <dimen name="row_height">48dp</dimen>
    <dimen name="row_pad_h">10dp</dimen>
    <dimen name="divider_height">1dp</dimen>
    <dimen name="focus_rule">2dp</dimen>

    <dimen name="text_title">13sp</dimen>
    <dimen name="text_sub">11sp</dimen>
    <dimen name="text_value">11sp</dimen>
    <dimen name="text_notice">11sp</dimen>
    <dimen name="text_empty">13sp</dimen>

    <!-- The session's own name and state, in a slim strip over its
         transcript rather than a second title bar. -->
    <dimen name="header_height">22dp</dimen>
    <dimen name="header_text">12sp</dimen>
    <dimen name="state_text">11sp</dimen>

    <!-- Full-width chat areas keep only readable inner padding and a small
         separator between turns. -->
    <dimen name="text_bubble">14sp</dimen>
    <dimen name="text_tool">11sp</dimen>
    <dimen name="bubble_pad_h">10dp</dimen>
    <dimen name="bubble_pad_top">9dp</dimen>
    <dimen name="bubble_pad_bottom">9dp</dimen>
    <dimen name="chat_area_gap">1dp</dimen>
</resources>
