<?xml version="1.0" encoding="utf-8"?>
<!-- A button in the transcript: the teal of the chrome, outlined, so it
     reads as something to press rather than something said. The row's own
     focus wash shows around it when it is the selected row. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/row" />
    <stroke android:width="1dp" android:color="@color/accent_text" />
    <corners android:radius="3dp" />
</shape>
