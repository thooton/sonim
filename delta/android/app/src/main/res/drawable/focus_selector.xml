<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed list focus, copied in shape from the stock Music app: a pale
     fill with saturated rules along the top and bottom edges only, and no side
     border. The rules come from a four-sided stroke whose left and right edges
     are pushed outside the drawable bounds by the negative insets, which is the
     same trick the platform's own tab indicator uses. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><color android:color="@color/press_fill" /></item>
            <item android:left="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/focus_rule" android:color="@color/focus_rule" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><color android:color="@color/focus_fill" /></item>
            <item android:left="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/focus_rule" android:color="@color/focus_rule" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item><color android:color="@color/focus_fill" /></item>
            <item android:left="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/focus_rule" android:color="@color/focus_rule" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item><color android:color="@color/row" /></item>
</selector>
