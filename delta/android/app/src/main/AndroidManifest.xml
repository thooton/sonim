<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The network, and handing a downloaded APK to the system installer.
         Everything the app keeps, downloads included, is in its own private
         directory. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only for "Move to" in Files, which puts a downloaded file in a shared
         folder such as Music. Asked for the first time it is used. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Lets Delta hand an APK to the Installer helper (../installer), which
         installs without the XP3's whitelist-gated installer screen. Granted
         only because both apps carry the shared signing key. -->
    <uses-permission android:name="com.installer.xp3.permission.INSTALL" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Cleartext is off: the app talks to the cloud and to the command
         center, both over https, and turning this off means nothing can
         quietly send either login in the clear. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Where the camera writes a picture taken from the menu. Not
             exported: the camera gets a one-off write grant on the intent. -->
        <provider
            android:name=".CaptureProvider"
            android:authorities="com.delta.xp3.capture"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Serves a downloaded file, read-only, to the installer or to the
             app that opens it. file:// URIs are refused from targetSdk 24, and
             FileProvider would mean a library. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="com.delta.xp3.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
