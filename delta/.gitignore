# An assembled APK has this deployment's live cloud login and command center
# token baked into it by :app:generateDefaults. Anything holding the file can
# spend the subscription and run code on the command center, so it is built
# locally and never committed.
*.apk
cloud-auth.json
auth.json
delta-center.json

*.class
bin/
build/
.gradle/
android/local.properties
