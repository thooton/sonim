<?xml version="1.0" encoding="utf-8"?>
<!-- A user turn is a full-width grey text area, not a speech bubble, with
     any pictures it carried drawn above the words. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/chat_row_selector"
    android:clickable="false"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:gravity="left"
    android:orientation="vertical"
    android:paddingTop="@dimen/chat_area_gap"
    android:paddingBottom="@dimen/chat_area_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_you"
        android:gravity="left"
        android:orientation="vertical"
        android:paddingLeft="@dimen/bubble_pad_h"
        android:paddingRight="@dimen/bubble_pad_h"
        android:paddingTop="@dimen/bubble_pad_top"
        android:paddingBottom="@dimen/bubble_pad_bottom">

        <!-- The message's pictures, one under another, above its text. -->
        <LinearLayout
            android:id="@+id/bubble_pictures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/bubble_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="@dimen/text_bubble" />
    </LinearLayout>
</LinearLayout>
