<?xml version="1.0" encoding="utf-8"?>
<!-- A message row carries the same full-bleed focus as a list row elsewhere in
     the app: a pale wash and a saturated rule along the top and bottom edges,
     with the bubble drawn on top of it. At rest it is transparent, so the
     transcript background shows through and an unfocused list is just
     messages. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><color android:color="@color/press_fill" /></item>
            <item android:left="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/focus_rule" android:color="@color/focus_rule" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><color android:color="@color/focus_fill" /></item>
            <item android:left="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/focus_rule" android:color="@color/focus_rule" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item><color android:color="@color/focus_fill" /></item>
            <item android:left="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/focus_rule" android:color="@color/focus_rule" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
