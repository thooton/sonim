<?xml version="1.0" encoding="utf-8"?>
<!-- The open tab: a short ink rule along the top of its label. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top|center_horizontal" android:width="28dp" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
        </shape>
    </item>
</layer-list>
