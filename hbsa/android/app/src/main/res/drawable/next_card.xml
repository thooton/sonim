<?xml version="1.0" encoding="utf-8"?>
<!-- The next event: a gold card, outlined in maroon when the d-pad is on it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="6dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/gold_fill" />
                <stroke android:width="@dimen/family_rule" android:color="@color/focus_rule" />
                <corners android:radius="8dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="6dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/gold_fill" />
                <stroke android:width="@dimen/family_rule" android:color="@color/gold" />
                <corners android:radius="8dp" />
            </shape>
        </inset>
    </item>
</selector>
