<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Violet-magenta. The deep violet is the status bar; the bright
         violet-magenta marks the event under the d-pad, the day headings
         and the dates in a caption. -->
    <color name="primary">#3A0D4A</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#D9B8E3</color>

    <color name="page">#FFFFFF</color>
    <color name="row">#FFFFFF</color>
    <color name="divider">#EFE6F2</color>
    <!-- The event under the d-pad: a shaded card with a bar down its left edge. -->
    <color name="focus_fill">#F3E2F7</color>
    <color name="focus_rule">#9C1FA6</color>
    <color name="press_fill">#E9CCEF</color>
    <color name="highlight">#249C1FA6</color>

    <color name="text">#1E1A20</color>
    <color name="text_muted">#736A77</color>
    <color name="past">#A79DAB</color>
    <color name="thumb">#EFE7F2</color>
    <!-- A date or time in a caption. -->
    <color name="mark">#F8D8F2</color>
</resources>
