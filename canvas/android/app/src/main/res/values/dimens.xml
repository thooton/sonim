<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Measured against the XP3's 240x320 mdpi panel: 24dp status bar, 36dp
         tab bar, leaving 260dp of content. An assignment row is 54dp, so five
         of them fit under a section header without the list ending mid-row. -->
    <dimen name="tab_bar_height">36dp</dimen>
    <dimen name="tab_underline">3dp</dimen>
    <!-- 12sp, not 13: "Assigned" is the longest tab label and the cells are
         60dp wide, so a step down is what keeps it from ellipsizing. -->
    <dimen name="tab_text">12sp</dimen>

    <dimen name="row_height">54dp</dimen>
    <dimen name="section_height">26dp</dimen>
    <dimen name="row_pad_h">10dp</dimen>
    <dimen name="divider_height">1dp</dimen>
    <dimen name="focus_rule">2dp</dimen>

    <dimen name="text_title">13sp</dimen>
    <dimen name="text_body">13sp</dimen>
    <dimen name="text_sub">11sp</dimen>
    <dimen name="text_section">11sp</dimen>
    <!-- The date column reads first because it is the answer to the only
         question this list is asked ("when"), not because it is set big. One
         step above the sub line is enough. -->
    <dimen name="text_when">12sp</dimen>
    <dimen name="text_when_sub">10sp</dimen>
    <dimen name="text_caret">9sp</dimen>
    <dimen name="text_detail_title">16sp</dimen>

    <!-- Full-width chat areas keep only readable inner padding and a small
         separator between turns. -->
    <dimen name="text_bubble">14sp</dimen>
    <dimen name="text_bubble_time">10sp</dimen>
    <!-- Their bubble is not padded evenly: 17px above the cap of the first
         line once the font's own padding is counted, and 6px under the time,
         which is what stops the time from looking like a line of the message. -->
    <dimen name="bubble_pad_h">10dp</dimen>
    <dimen name="bubble_pad_top">13dp</dimen>
    <dimen name="bubble_pad_bottom">4dp</dimen>
    <dimen name="bubble_time_gap">5dp</dimen>
    <dimen name="chat_area_gap">1dp</dimen>
</resources>
