<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Everything visible is drawn in code from Look, which follows the
         theme setting; the window itself only needs to start light and plain
         so nothing flashes before the first screen is built. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:colorControlHighlight">@color/highlight</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
</resources>
