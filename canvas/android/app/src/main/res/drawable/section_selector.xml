<?xml version="1.0" encoding="utf-8"?>
<!-- A section heading is text on the row surface (small, Medium, muted)
     rather than a grey band, and takes the same focus card as the rows
     beneath it when the d-pad is on it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/family_focus" />
    <item android:state_selected="true" android:drawable="@drawable/family_focus" />
    <item android:state_focused="true" android:drawable="@drawable/family_focus" />
    <item><color android:color="@color/row" /></item>
</selector>
