<?xml version="1.0" encoding="utf-8"?>
<!-- Section headers take the same focus language as the rows beneath them
     (pale fill, saturated rules top and bottom) but rest a shade darker than
     the row surface, so a collapsed list still reads as bands of grey with
     white work inside them rather than as one undifferentiated column. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><color android:color="@color/press_fill" /></item>
            <item android:left="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/focus_rule" android:color="@color/focus_rule" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><color android:color="@color/focus_fill" /></item>
            <item android:left="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/focus_rule" android:color="@color/focus_rule" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item><color android:color="@color/focus_fill" /></item>
            <item android:left="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/focus_rule" android:color="@color/focus_rule" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item><color android:color="@color/section_fill" /></item>
</selector>
