<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <!-- The tab bar is the screen's title: it names where you are, so no tab
         repeats its own name as a heading in the content below. An assignment
         opened from a list hides this bar entirely rather than dimming it,
         because a detail on a 240px screen needs every row it can get and
         half-available navigation is worse than none. -->
    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_bar_height"
        android:background="@color/primary"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <Button android:id="@+id/tab_assigned" style="@style/TabButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="false" android:focusableInTouchMode="false" android:text="@string/assigned" />
        <Button android:id="@+id/tab_missing" style="@style/TabButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="false" android:focusableInTouchMode="false" android:text="@string/missing" />
        <Button android:id="@+id/tab_done" style="@style/TabButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="false" android:focusableInTouchMode="false" android:text="@string/done" />
        <Button android:id="@+id/tab_chat" style="@style/TabButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="false" android:focusableInTouchMode="false" android:text="@string/chat" />
    </LinearLayout>

    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/page" />
</LinearLayout>
