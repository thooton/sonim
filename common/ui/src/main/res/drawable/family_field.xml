<?xml version="1.0" encoding="utf-8"?>
<!-- A place to type: a soft tinted fill with no border at rest, white with
     the accent outline while it takes the keys. A field with its label
     inside sets this on the row holding both, with addStatesFromChildren so
     the row lights up when its EditText has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/row" />
            <stroke android:width="@dimen/family_rule" android:color="@color/focus_rule" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/field_fill" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
