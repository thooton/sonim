<?xml version="1.0" encoding="utf-8"?>
<!-- A list's hairline, inset to the text edge as iOS lists do, so rows read
     as one column of text rather than as the cells of a table. Set it as the
     ListView's divider with a dividerHeight of 1dp. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="@dimen/family_gutter">
    <shape android:shape="rectangle">
        <solid android:color="@color/divider" />
        <size android:height="1dp" />
    </shape>
</inset>
