<?xml version="1.0" encoding="utf-8"?>
<!-- A screen's one main action: outlined in the accent at rest, as Charge's
     buttons are, and filled with it once focus is on it, so there is no doubt
     what OK will do. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/row" />
            <stroke android:width="@dimen/family_rule" android:color="@color/divider" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_rule" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_rule" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/row" />
            <stroke android:width="@dimen/family_rule" android:color="@color/focus_rule" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
