<?xml version="1.0" encoding="utf-8"?>
<!-- A list row in the family look: plain at rest, and when it is the one the
     d-pad is on, a rounded card 4dp in from the sides with a pale wash and a
     1.5dp outline in the app's accent. The row keeps its 10dp padding, so its
     text sits 6dp inside the card and does not move when focus lands on it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="1dp" android:insetBottom="1dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/press_fill" />
                <stroke android:width="@dimen/family_rule" android:color="@color/focus_rule" />
                <corners android:radius="8dp" />
            </shape>
        </inset>
    </item>
    <item android:state_selected="true">
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="1dp" android:insetBottom="1dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/focus_fill" />
                <stroke android:width="@dimen/family_rule" android:color="@color/focus_rule" />
                <corners android:radius="8dp" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="1dp" android:insetBottom="1dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/focus_fill" />
                <stroke android:width="@dimen/family_rule" android:color="@color/focus_rule" />
                <corners android:radius="8dp" />
            </shape>
        </inset>
    </item>
    <item><color android:color="@color/row" /></item>
</selector>
