<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind FamilyDialog: 12dp corners. The inset is the margin
     the platform's own dialog background keeps from the screen's edges. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="16dp" android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/row" />
        <corners android:radius="12dp" />
    </shape>
</inset>
