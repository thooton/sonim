<?xml version="1.0" encoding="utf-8"?>
<!-- The focus card for a list whose typing box or activity keeps the focus
     and picks a row itself (Mail, Places, Source): the card shows only on
     the row marked activated, so ListView's own selection, which it keeps
     on some row whether or not the list has focus, draws nothing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="1dp" android:insetBottom="1dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/focus_fill" />
                <stroke android:width="@dimen/family_rule" android:color="@color/focus_rule" />
                <corners android:radius="8dp" />
            </shape>
        </inset>
    </item>
    <item><color android:color="@color/row" /></item>
</selector>
