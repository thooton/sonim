<?xml version="1.0" encoding="utf-8"?>
<!-- The family look (see DESIGN.md at the root): the defaults for what the
     family_* drawables and FamilyDialog draw with that defaults.xml does not
     already name. Every app that uses them defines its own values under the
     same names, and those win. -->
<resources>
    <!-- A soft field at rest, and the page behind grouped cards. -->
    <color name="field_fill">#F1F1F4</color>
    <color name="grouped_page">#F2F2F5</color>
    <!-- The 1.5dp outline of a focused row, field or menu item. -->
    <dimen name="family_rule">1.5dp</dimen>
    <!-- Where every line of text starts; hairlines are inset to it. -->
    <dimen name="family_gutter">10dp</dimen>
</resources>
