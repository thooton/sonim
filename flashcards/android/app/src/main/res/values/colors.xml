<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Anki's light theme (its sass variables), so the app reads as Anki's
         desktop window on a small screen. -->
    <color name="canvas">#F5F5F5</color>
    <color name="elevated">#FFFFFF</color>
    <color name="border">#C4C4C4</color>
    <color name="border_subtle">#E4E4E4</color>
    <color name="text">#020202</color>
    <color name="text_subtle">#737373</color>
    <color name="text_faint">#A3A3A3</color>

    <!-- The three queues, as Anki colours them everywhere. -->
    <color name="state_new">#3B82F6</color>
    <color name="state_learn">#DC2626</color>
    <color name="state_review">#16A34A</color>

    <!-- Anki's statistics: Card Counts' slices (d3's Blues, Oranges, Reds
         and Greens, as Anki picks them) and its histograms' bars. -->
    <color name="count_new">#6BAED6</color>
    <color name="count_learn">#FD8D3C</color>
    <color name="count_relearn">#FB6A4A</color>
    <color name="count_young">#74C476</color>
    <color name="count_mature">#31A354</color>
    <color name="bar_due">#31A354</color>
    <color name="bar_interval">#3182BD</color>
    <color name="bar_recall">#74C476</color>

    <!-- Anki's focus ring and the wash of a row under the pointer, here
         under the d-pad. -->
    <color name="focus">#3B82F6</color>
    <color name="hover">#E5E5E5</color>
    <color name="button_top">#FFFFFF</color>
    <color name="button_bottom">#F2F2F2</color>
    <color name="pressed">#DADADA</color>

    <!-- The names common/ui's dialogs and lists look for. -->
    <color name="primary">#F5F5F5</color>
    <color name="focus_rule">#3B82F6</color>
    <color name="focus_fill">#E5E5E5</color>
    <color name="divider">#E4E4E4</color>
    <color name="text_muted">#737373</color>
</resources>
