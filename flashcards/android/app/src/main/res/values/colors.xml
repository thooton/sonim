<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Warm paper and brown ink, following Mimi's parchment-like shell. -->
    <color name="primary">#6B5945</color>
    <color name="primary_dark">#4B3D2F</color>
    <color name="on_primary">#FBFAF7</color>
    <color name="on_primary_dim">#DED5C8</color>

    <color name="page">#EFEAE3</color>
    <color name="row">#FBFAF7</color>
    <color name="divider">#DFD9CD</color>
    <color name="outline">#CBC2B1</color>

    <!-- Focus is the one place colour is allowed to be assertive: a pale wash
         and a 2dp rule rather than a filled block. -->
    <color name="focus_fill">#E7DED1</color>
    <color name="focus_rule">#6B5945</color>
    <color name="press_fill">#D9CEBE</color>

    <color name="text">#1D1B16</color>
    <color name="text_muted">#7D766A</color>
    <color name="warning">#B23C2B</color>
    <color name="success">#2F8557</color>
    <color name="disabled">#E4DFD5</color>
    <color name="disabled_text">#A49C8D</color>

    <!-- Deck counts keep Anki's familiar semantic colours. -->
    <color name="count_new">#2F6FD0</color>
    <color name="count_learn">#B23C2B</color>
    <color name="count_due">#2F8557</color>

    <!-- Ratings are controls, not status indicators, so all four are neutral. -->
    <color name="chip">#DDD4C7</color>
    <color name="chip_text">#4B463C</color>
</resources>
