<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Anki's light window: a pale grey canvas under a status bar of the same
         grey, with dark icons. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorPrimary">@color/canvas</item>
        <item name="android:colorPrimaryDark">@color/canvas</item>
        <item name="android:colorAccent">@color/focus</item>
        <item name="android:colorControlHighlight">#243B82F6</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
