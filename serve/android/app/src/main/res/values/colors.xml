<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A deep teal in the family's four tones (DESIGN.md): the band near
         black, the accent for the button and focus, a pale wash, and greys
         tinted to match. Green is kept for one thing, the dot that says the
         server is live. -->
    <color name="primary">#0D3236</color>
    <color name="primary_dark">#0D3236</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#9CC3C6</color>

    <color name="page">#EEF3F3</color>
    <color name="row">#FFFFFF</color>
    <color name="divider">#DFEAEB</color>
    <color name="field_fill">#EEF4F4</color>

    <color name="focus_fill">#E7F4F5</color>
    <color name="focus_rule">#11707A</color>
    <color name="press_fill">#CFE6E8</color>
    <!-- The platform's highlight (a stock menu's item under the d-pad, a
         press): the accent, faint enough that what it covers stays legible. -->
    <color name="highlight">#2411707A</color>

    <color name="text">#1B1B1D</color>
    <color name="text_muted">#5D6A6B</color>
    <color name="live">#12A150</color>
    <color name="live_text">#12783E</color>
    <color name="idle">#B3BDBE</color>
    <color name="problem">#B3261E</color>
</resources>
