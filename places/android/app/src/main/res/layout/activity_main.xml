<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <!-- Where to search near (kept between searches), then what to find:
         soft fields with their labels inside, so the typed text starts on
         the same 10dp edge as the results. Hidden while a place's details
         fill the screen. -->
    <LinearLayout
        android:id="@+id/form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp">
        <LinearLayout style="@style/LabelledField">
            <TextView style="@style/FieldLabel" android:text="@string/label_near" />
            <EditText
                android:id="@+id/near"
                style="@style/FieldText"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textCapWords|textPostalAddress" />
        </LinearLayout>
        <LinearLayout style="@style/LabelledField" android:layout_marginTop="4dp">
            <TextView style="@style/FieldLabel" android:text="@string/label_find" />
            <EditText
                android:id="@+id/query"
                style="@style/FieldText"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="textCapSentences" />
        </LinearLayout>
    </LinearLayout>

    <!-- What the search found, or is doing. No bar naming the app above the
         fields: you just opened it. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingBottom="5dp"
        android:paddingLeft="@dimen/pad_h"
        android:paddingRight="@dimen/pad_h"
        android:paddingTop="7dp"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_status" />

    <!-- The results. The focus card is drawn by the adapter, since a typing
         box keeps the focus. -->
    <ListView
        android:id="@+id/results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="false" />

    <!-- One place, in place of the results, laid out as Google Maps lays
         one out: built by PlacePage. -->
    <ScrollView
        android:defaultFocusHighlightEnabled="false"
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/grouped_page"
        android:focusable="false"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/detail_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />
    </ScrollView>
</LinearLayout>
