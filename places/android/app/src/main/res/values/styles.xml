<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, in Google Sans, as Google Maps is: the status and navigation
         bars are the sheet's own colour. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:colorPrimary">@color/page</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlHighlight">@color/highlight</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/MapsDialog</item>
    </style>

    <!-- Menus and the login: Maps' raised dark surface, its teal buttons. -->
    <style name="MapsDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:colorBackground">#2A2A2C</item>
        <item name="android:colorAccent">@color/link</item>
        <item name="android:colorControlHighlight">@color/highlight</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/text</item>
        <item name="android:windowBackground">@drawable/dialog</item>
    </style>

    <style name="HeaderField">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@null</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
        <item name="android:textSize">@dimen/text_query</item>
    </style>
</resources>
