<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Google Maps' dark theme, sampled from its search results and place
         sheet on a phone. The page is Maps' near-black sheet, parted by
         hairlines, and the one hue is Maps' teal: a filter chip that is on
         is a deep teal with pale teal text, and icons, links, the cursor and
         the loading bar are the bright teal. -->
    <color name="page">#131314</color>
    <color name="hairline">#3E3E40</color>
    <!-- The clear button and recent searches' clocks: Maps' grey on the sheet. -->
    <color name="button">#303030</color>
    <!-- A tonal card on the sheet, as Maps draws "Your visits". -->
    <color name="card">#192123</color>
    <color name="photo">#26282A</color>

    <color name="text">#E3E3E3</color>
    <color name="text_muted">#ABABAD</color>
    <color name="text_hint">#8E8E90</color>

    <color name="chip">#00363F</color>
    <color name="on_chip">#A6EEFB</color>
    <color name="accent">#5CB8C9</color>
    <color name="link">#7DD3E3</color>
    <color name="filter_rule">#5C5F61</color>

    <!-- The row under the d-pad: Maps has no focus, so it takes the tonal
         card's teal, lifted; a chip under it takes a pale teal ring. -->
    <color name="picked">#1C2B2E</color>
    <color name="highlight">#335CB8C9</color>

    <color name="open">#81C995</color>
    <color name="closed">#F2B8B5</color>
    <color name="star">#FFC42A</color>
    <color name="star_empty">#5A5A5D</color>
    <color name="wheelchair">#A8C7FA</color>
</resources>
