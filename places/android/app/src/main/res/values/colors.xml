<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A map green in the family's four tones (DESIGN.md): the band near
         black, the accent for focus and for what can be acted on (a phone
         number, a website), a pale wash behind the picked result, and greys
         tinted to match. The status bar is the band's own colour. -->
    <color name="primary">#0F3624</color>
    <color name="primary_dark">#0F3624</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#A3C6B2</color>

    <color name="page">#FFFFFF</color>
    <color name="row">#FFFFFF</color>
    <color name="divider">#E1EAE5</color>
    <color name="field_fill">#EFF3F1</color>
    <color name="grouped_page">#F0F4F2</color>

    <color name="focus_fill">#EAF5EF</color>
    <color name="focus_rule">#1D6A45</color>
    <color name="press_fill">#D3E9DC</color>
    <!-- The platform's highlight (a stock menu's item under the d-pad, a
         press): the accent, faint enough that what it covers stays legible. -->
    <color name="highlight">#241D6A45</color>

    <color name="text">#1B1B1D</color>
    <color name="text_muted">#5E6A64</color>
    <color name="input_hint">#89928D</color>
    <!-- Open and closed, on a result's last line: the one thing worth
         reading at a glance. -->
    <color name="open">#1E7B34</color>
    <color name="closed">#B3261E</color>
    <!-- A rating's stars, filled and not: the family's gold, on a grey
         tinted to the green. -->
    <color name="star">#C58A00</color>
    <color name="star_empty">#D6DED9</color>
</resources>
