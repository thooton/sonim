<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A deep map green across the top; the rest is the sibling apps' greys,
         with focus marked by a rule rather than a filled block. -->
    <color name="primary">#1E5631</color>
    <color name="primary_dark">#133A20</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#A7C4AF</color>

    <color name="page">#FAFAFA</color>
    <color name="row">#FFFFFF</color>
    <color name="section_fill">#EFEFEF</color>
    <color name="divider">#DCDCDC</color>

    <color name="focus_fill">#E6EFE8</color>
    <color name="focus_rule">#1E5631</color>
    <color name="press_fill">#CFE0D3</color>

    <color name="text">#1A1A1A</color>
    <color name="text_muted">#6E6E6E</color>
    <!-- Open and closed, on a result's last line: the one thing worth
         reading at a glance. -->
    <color name="open">#1E7B34</color>
    <color name="closed">#B3261E</color>

    <!-- The stock Messages compose field, as in the sibling apps. -->
    <color name="input_text">#D8000000</color>
    <color name="input_hint">#7F000000</color>
    <color name="input_border">#7F000000</color>
</resources>
