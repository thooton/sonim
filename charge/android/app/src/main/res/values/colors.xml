         of every screen, so it has to sit back rather than shout. -->
    <color name="primary">#0A2A57</color>
    <color name="primary_dark">#071B39</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#8CA3C4</color>

    <color name="page">#FAFAFA</color>
    <color name="row">#FFFFFF</color>
    <color name="divider">#DCDCDC</color>
    <color name="outline">#C7D2E0</color>

