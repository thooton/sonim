    <color name="focus_fill">#E6EDF7</color>
    <color name="focus_rule">#14417F</color>
    <color name="press_fill">#D3DFEE</color>

    <color name="text">#1A1A1A</color>
    <color name="text_muted">#6B7280</color>
    <color name="capacity_low">#B45309</color>
    <color name="warning">#B3261E</color>
