<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Measured against the stock Music app on the XP3's 240x320 mdpi panel:
         24dp status bar, 36dp tab bar, 48dp rows, 1dp dividers. Rows here are
         52dp because they carry a value column as well as two text lines. -->
    <dimen name="tab_bar_height">36dp</dimen>
    <dimen name="tab_underline">3dp</dimen>
    <dimen name="tab_text">13sp</dimen>

    <!-- 62dp fits street, city and status lines without the rows changing
         height as addresses get longer. -->
    <dimen name="row_height">62dp</dimen>
    <dimen name="row_pad_h">10dp</dimen>
    <dimen name="divider_height">1dp</dimen>
    <dimen name="focus_rule">2dp</dimen>

    <dimen name="button_height">44dp</dimen>
    <dimen name="button_text">14sp</dimen>

    <dimen name="text_title">13sp</dimen>
    <dimen name="text_body">13sp</dimen>
    <dimen name="text_sub">11sp</dimen>
    <dimen name="text_section">11sp</dimen>
    <dimen name="text_value">12sp</dimen>
    <!-- One step above the title, no more. The price column reads first because
         it is bold and full-strength black in a row where everything else is
         muted, not because it is set big. The unit beneath it only has to be
         legible, not readable at a glance. -->
    <dimen name="text_price">14sp</dimen>
    <dimen name="text_price_unit">10sp</dimen>
    <dimen name="text_detail_title">16sp</dimen>
    <dimen name="text_status">20sp</dimen>
</resources>
