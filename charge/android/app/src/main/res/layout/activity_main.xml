<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <!-- The tab bar is the screen's title: it names where you are, so no tab
         repeats its own name as a heading in the content below. -->
    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_bar_height"
        android:background="@color/primary"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <Button android:id="@+id/tab_favorites" style="@style/TabButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="false" android:focusableInTouchMode="false" android:text="@string/favorites" />
        <Button android:id="@+id/tab_discover" style="@style/TabButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="false" android:focusableInTouchMode="false" android:text="@string/discover" />
        <Button android:id="@+id/tab_session" style="@style/TabButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="false" android:focusableInTouchMode="false" android:text="@string/session" />
        <Button android:id="@+id/tab_history" style="@style/TabButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="false" android:focusableInTouchMode="false" android:text="@string/history" />
    </LinearLayout>

    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/page" />
</LinearLayout>
