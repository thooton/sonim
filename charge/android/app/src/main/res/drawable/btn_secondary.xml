<?xml version="1.0" encoding="utf-8"?>
<!-- Supporting actions: a hairline outline at rest, and the same focus fill and
     rule as list rows so one focus language covers the whole app. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/disabled" />
            <stroke android:width="1dp" android:color="@color/outline" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/press_fill" />
            <stroke android:width="2dp" android:color="@color/focus_rule" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <stroke android:width="2dp" android:color="@color/focus_rule" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <stroke android:width="2dp" android:color="@color/focus_rule" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/row" />
            <stroke android:width="1dp" android:color="@color/outline" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
