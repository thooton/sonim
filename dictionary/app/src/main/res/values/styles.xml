<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light chrome: a white status bar with dark icons. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/page</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:colorControlHighlight">@color/highlight</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:fontFamily">@font/plex_sans</item>
    </style>
</resources>
