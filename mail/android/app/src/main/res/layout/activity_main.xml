<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <!-- The bar names the folder (or what is being written) and, on the
         right, which conversation is picked. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bar_height"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/pad_h"
        android:paddingRight="@dimen/pad_h">
        <TextView android:id="@+id/title" style="@style/FamilyTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" />
        <TextView android:id="@+id/count" style="@style/FamilyTitleMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingBottom="6dp"
        android:paddingLeft="@dimen/pad_h"
        android:paddingRight="@dimen/pad_h"
        android:paddingTop="6dp"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_status"
        android:visibility="gone" />

    <!-- The conversations. The focus card is drawn by the adapter. -->
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="false" />

    <!-- One conversation, in place of the list. -->
    <ScrollView
        android:defaultFocusHighlightEnabled="false"
        android:id="@+id/reader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/row"
        android:focusable="false"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone">
        <TextView
            android:id="@+id/reader_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:paddingBottom="8dp"
            android:paddingLeft="@dimen/pad_h"
            android:paddingRight="@dimen/pad_h"
            android:paddingTop="9dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text"
            android:textIsSelectable="false"
            android:textSize="@dimen/text_detail" />
    </ScrollView>

    <!-- Writing: whom to, whom to copy (shown when asked for), the subject,
         then the message filling the rest. Each line is a row with a
         hairline under it rather than a box. -->
    <LinearLayout
        android:id="@+id/compose"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout style="@style/FieldRow">
            <TextView style="@style/FieldLabel" android:text="@string/label_to" />
            <EditText
                android:id="@+id/to"
                style="@style/Field"
                android:hint="@string/hint_to"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textEmailAddress" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cc_row" style="@style/FieldRow" android:visibility="gone">
            <TextView style="@style/FieldLabel" android:text="@string/label_cc" />
            <EditText
                android:id="@+id/cc"
                style="@style/Field"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textEmailAddress" />
        </LinearLayout>
        <LinearLayout style="@style/FieldRow">
            <TextView style="@style/FieldLabel" android:text="@string/label_subject" />
            <EditText
                android:id="@+id/subject"
                style="@style/Field"
                android:hint="@string/hint_subject"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textCapSentences|textAutoCorrect" />
        </LinearLayout>
        <EditText
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/hint_body"
            android:imeOptions="flagNoExtractUi|flagNoEnterAction"
            android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
            android:lineSpacingExtra="2dp"
            android:paddingBottom="8dp"
            android:paddingLeft="@dimen/pad_h"
            android:paddingRight="@dimen/pad_h"
            android:paddingTop="8dp"
            android:scrollbars="vertical"
            android:textColor="@color/text"
            android:textColorHint="@color/input_hint"
            android:textSize="@dimen/text_input" />
    </LinearLayout>
</LinearLayout>
