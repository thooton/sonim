<?xml version="1.0" encoding="utf-8"?>
<!-- One message of a conversation, as Thunderbird's message header: the
     sender's monogram, their name and when, to whom (or, folded, the start
     of it); then its text, a note where a quote was cut, and its files. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:paddingLeft="@dimen/pad_h"
        android:paddingRight="@dimen/pad_h"
        android:paddingTop="9dp">
        <TextView android:id="@+id/avatar" style="@style/Monogram" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/name"
                    style="@style/RowLine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_name" />
                <TextView
                    android:id="@+id/date"
                    style="@style/RowLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="6dp"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/detail"
                style="@style/RowLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_meta" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:paddingBottom="10dp"
        android:paddingLeft="@dimen/pad_h"
        android:paddingRight="@dimen/pad_h"
        android:textColor="@color/text"
        android:textSize="@dimen/text_detail" />

    <TextView
        android:id="@+id/quoted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="@dimen/pad_h"
        android:background="@drawable/quoted_pill"
        android:includeFontPadding="false"
        android:paddingBottom="4dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:textColor="@color/text_read"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/files"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="10dp"
        android:paddingLeft="@dimen/pad_h"
        android:paddingRight="@dimen/pad_h" />
</LinearLayout>
