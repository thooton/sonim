<?xml version="1.0" encoding="utf-8"?>
<!-- An action in a menu: its icon, what it does, and the key that does it
     straight from the list or a conversation, as Thunderbird's menus show
     their shortcuts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="38dp"
    android:orientation="horizontal"
    android:paddingLeft="18dp"
    android:paddingRight="14dp">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/label"
        style="@style/RowLine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_weight="1"
        android:textColor="@color/text"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:background="@drawable/keycap"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="18dp"
        android:paddingBottom="2dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="2dp"
        android:textColor="@color/text_read"
        android:textSize="11sp" />
</LinearLayout>
