<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/focus_rule</item>
        <item name="android:colorControlHighlight">@color/highlight</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/FamilyDialog</item>
        <item name="android:popupMenuStyle">@style/FamilyPopupMenu</item>
        <item name="android:contextPopupMenuStyle">@style/FamilyPopupMenu</item>
    </style>

    <!-- One line of the composer: its label, then the field, on a row with a
         hairline under it that takes the focus wash while the field has the
         keys, as in the phone's own mail apps rather than as boxes on a form. -->
    <style name="FieldRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:addStatesFromChildren">true</item>
        <item name="android:background">@drawable/family_line_field</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">@dimen/pad_h</item>
        <item name="android:paddingRight">@dimen/pad_h</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">@dimen/label_width</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@null</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="android:textSize">@dimen/text_input</item>
    </style>
</resources>
