<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thunderbird's light palette (thunderbird-android's Bolt theme): warm
         greys for the chrome, white for what is unread, Thunderbird blue for
         focus, links and what is new. Mail is the one light-chromed app of
         the family (DESIGN.md): its bar is the surface, not a dark band. -->
    <color name="primary">#004F9B</color>
    <color name="primary_dark">#F1EDEC</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#A9C7FF</color>

    <!-- The app bar and status bar (surfaceContainer), the folder pane
         (surface), and the list: unread rows white, read ones a shade
         greyer (surfaceContainerLow), as Thunderbird draws them. -->
    <color name="bar">#F1EDEC</color>
    <color name="drawer">#FCF8F8</color>
    <color name="scrim">#66000000</color>
    <color name="page">#FFFFFF</color>
    <color name="row">#FFFFFF</color>
    <color name="row_read">#F6F3F2</color>
    <color name="divider">#E2DEDD</color>
    <color name="field_fill">#F1EDEC</color>

    <color name="focus_fill">#E4EDF8</color>
    <color name="focus_rule">#004F9B</color>
    <color name="press_fill">#CFDFF2</color>
    <!-- The platform's highlight (a menu's item under the d-pad, a press). -->
    <color name="highlight">#24004F9B</color>

    <!-- Thunderbird's secondary container: the folder under the d-pad, and
         people's monograms (its 15% wash behind the letter). -->
    <color name="pill">#2E61A0</color>
    <color name="pill_wash">#DCE6F3</color>
    <color name="avatar_fill">#E0E7F1</color>

    <!-- A note under the bar: Thunderbird's info container. -->
    <color name="info_fill">#F0F8FF</color>
    <color name="info_text">#004F9B</color>

    <color name="text">#1C1B1B</color>
    <color name="text_read">#45474A</color>
    <color name="text_muted">#636569</color>
    <color name="input_hint">#85878A</color>
    <color name="icon">#45474A</color>
    <!-- A star, and a draft not yet sent (or an address that isn't one). -->
    <color name="star">#C58A00</color>
    <color name="draft">#B3261E</color>
</resources>
