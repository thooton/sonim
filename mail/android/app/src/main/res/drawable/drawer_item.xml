<?xml version="1.0" encoding="utf-8"?>
<!-- A folder in the folder pane, as Thunderbird's drawer draws one: a round
     pill, filled while the d-pad is on it. The folder open now is washed with
     drawer_open instead: ListView sets its rows' selected state itself. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="1dp" android:insetBottom="1dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/pill" />
                <corners android:radius="17dp" />
            </shape>
        </inset>
    </item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
