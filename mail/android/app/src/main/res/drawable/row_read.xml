<?xml version="1.0" encoding="utf-8"?>
<!-- A conversation in the list, read: Thunderbird's greyer read row,
     and the family's focus card on it when it is the one the d-pad is on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item><color android:color="@color/row_read" /></item>
            <item android:left="4dp" android:right="4dp" android:top="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/focus_fill" />
                    <stroke android:width="@dimen/family_rule" android:color="@color/focus_rule" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item><color android:color="@color/row_read" /></item>
</selector>
