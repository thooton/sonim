<?xml version="1.0" encoding="utf-8"?>
<!-- How many messages a conversation holds, beside its subject: Thunderbird's
     conversation counter, outlined. Unread ones are tinted in code. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@color/text_muted" />
    <corners android:radius="6dp" />
</shape>
