<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fetching the APK, and handing it to the system installer. The download
         lands in the app's own cache, so no storage permission is needed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Cleartext stays allowed (the targetSdk 27 default): the address is
         whatever the person types, and plenty of APK links are plain http. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the downloaded APK to the installer. file:// URIs are
             refused from targetSdk 24, and FileProvider would mean a library. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.downloader.xp3.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
