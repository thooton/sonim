<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Authy's list view, sampled from its Play Store screenshots and its
         APK (27.7.1): pill cards of white on a pale grey page, Twilio's
         navy ink for names, codes and the add button. -->
    <color name="page">#F4F4F6</color>
    <color name="card">#FFFFFF</color>
    <color name="ink">#121C2D</color>
    <color name="ink_muted">#606B85</color>
    <!-- The countdown ring's track, and the card's soft shadow. -->
    <color name="track">#E1E3EA</color>
    <color name="shadow">#14121C2D</color>

