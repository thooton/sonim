<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Google Tasks' palette, sampled from its Play Store screenshots: a
         blue-grey page with white cards on it, Google blue for what is
         chosen, and Material 3's near-black and grey for text and icons.
         The status bar is the page's own colour, with dark icons. -->
    <color name="primary">#F0F4F9</color>
    <color name="primary_dark">#F0F4F9</color>
    <color name="on_primary">#1F1F1F</color>
    <color name="on_primary_dim">#444746</color>

    <color name="page">#F0F4F9</color>
    <color name="row">#FFFFFF</color>
    <color name="card">#FFFFFF</color>
    <color name="divider">#E1E3E1</color>
    <color name="field_fill">#F0F4F9</color>

    <!-- Google blue: a finished task's tick, Save. -->
    <color name="accent">#0B57D0</color>
    <!-- The d-pad's row: Material 3's secondary container, the pale blue
         Google's own apps put behind the chosen item. -->
    <color name="focus_fill">#D3E3FD</color>
    <color name="focus_rule">#0B57D0</color>
    <color name="press_fill">#C2D7FA</color>
    <color name="highlight">#290B57D0</color>

    <color name="text">#1F1F1F</color>
    <color name="text_muted">#444746</color>
    <color name="done_text">#5E5E5E</color>
    <color name="icon">#444746</color>
    <color name="check_box">#444746</color>
    <color name="save_off">#A0A3A6</color>

    <!-- The menu and the new-task sheet: Material 3's surface containers. -->
    <color name="menu">#E9EEF6</color>
    <color name="sheet">#F0F4F9</color>

</resources>
