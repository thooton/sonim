<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The whole app is grey, chrome to checkbox: a neutral charcoal band
         across the top, and focus marked by a darker grey rule rather than by
         any hue. Colour is deliberately absent. -->
    <color name="primary">#424242</color>
    <color name="primary_dark">#212121</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#A8A8A8</color>

    <color name="page">#FAFAFA</color>
    <color name="row">#FFFFFF</color>
    <color name="section_fill">#EFEFEF</color>
    <color name="divider">#DCDCDC</color>
    <color name="outline">#CACACA</color>

    <!-- Focus is the one place colour is allowed to be assertive, and even
         there it is a 2dp rule and a pale wash rather than a filled block. -->
    <color name="focus_fill">#E8E8E8</color>
    <color name="focus_rule">#555555</color>
    <color name="press_fill">#D4D4D4</color>

    <color name="text">#1A1A1A</color>
    <color name="text_muted">#6E6E6E</color>
    <!-- A finished item steps back rather than disappearing: the list is a
         record of the day as much as a plan for it. -->
    <color name="done_text">#A0A0A0</color>
    <color name="check_box">#6E6E6E</color>
    <color name="disabled">#F2F2F2</color>
    <color name="disabled_text">#A0A0A0</color>

</resources>
