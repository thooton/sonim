<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Books' warm graphite with an amber accent, in the family's four
         tones (DESIGN.md): the band near black, the accent for focus and a
         ticked box, a pale amber wash behind the focused row, and greys
         tinted warm to match. The status bar is the band's own colour, so
         the two read as one header. -->
    <color name="primary">#23201C</color>
    <color name="primary_dark">#23201C</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#C7B9A6</color>

    <color name="page">#FFFFFF</color>
    <color name="row">#FFFFFF</color>
    <color name="divider">#ECE6DE</color>
    <color name="field_fill">#F5F1EC</color>

    <color name="focus_fill">#FBF2E5</color>
    <color name="focus_rule">#A85C00</color>
    <color name="press_fill">#F4E2C8</color>

    <color name="text">#1B1B1D</color>
    <color name="text_muted">#6D665D</color>
    <!-- A finished item steps back rather than disappearing: the list is a
         record of the day as much as a plan for it. -->
    <color name="done_text">#9C958B</color>
    <color name="check_box">#A9A39B</color>
</resources>
