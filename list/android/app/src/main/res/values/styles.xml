<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlHighlight">@color/highlight</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:popupMenuStyle">@style/TasksPopupMenu</item>
        <item name="android:contextPopupMenuStyle">@style/TasksPopupMenu</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/menu_row</item>
    </style>

    <!-- Material 3's menu: a blue-grey surface with small corners. -->
    <style name="TasksPopupMenu" parent="android:style/Widget.Material.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/menu_background</item>
        <item name="android:popupElevation">3dp</item>
        <item name="android:overlapAnchor">true</item>
    </style>

    <!-- The new-task sheet, which rises from the bottom of the screen as
         Google Tasks' does. -->
    <style name="TaskSheet" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/sheet_background</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlHighlight">@color/highlight</item>
        <item name="android:windowSoftInputMode">stateVisible|adjustResize</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
