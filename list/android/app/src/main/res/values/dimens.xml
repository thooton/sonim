<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Measured against the XP3's 240x320 mdpi panel: 24dp status bar, 36dp
         tab bar, leaving 260dp of content. A one-line item is 40dp, so six
         fit with room for the edge of a seventh to say the list goes on. -->
    <dimen name="tab_bar_height">36dp</dimen>
    <dimen name="tab_underline">3dp</dimen>
    <dimen name="tab_text">13sp</dimen>

    <dimen name="item_min_height">40dp</dimen>
    <dimen name="row_pad_h">10dp</dimen>
    <dimen name="focus_rule">2dp</dimen>
    <dimen name="text_item">14sp</dimen>
    <dimen name="check_size">18dp</dimen>
    <dimen name="check_gap">10dp</dimen>
</resources>
