<resources>
    <!-- Measured against the XP3's 240x320 mdpi panel: a 24dp status bar
         and no header, leaving 296dp of content. A one-line item is 40dp, so
         seven fit with room for the edge of an eighth to say the list goes
         on. -->
    <dimen name="tab_underline">3dp</dimen>

    <dimen name="item_min_height">40dp</dimen>
    <dimen name="row_pad_h">10dp</dimen>
    <dimen name="focus_rule">2dp</dimen>
    <dimen name="text_item">13.5sp</dimen>
    <dimen name="check_size">16dp</dimen>
    <dimen name="check_gap">10dp</dimen>
</resources>
