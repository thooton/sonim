<?xml version="1.0" encoding="utf-8"?>
<!-- An assistant turn is a full-width white text area. The live ellipsis and
     streamed answer use this same row, so the response grows in place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/chat_row_selector"
    android:clickable="false"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:gravity="left"
    android:orientation="vertical"
    android:paddingTop="@dimen/chat_area_gap"
    android:paddingBottom="@dimen/chat_area_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_agent"
        android:gravity="left"
        android:orientation="vertical"
        android:paddingLeft="@dimen/bubble_pad_h"
        android:paddingRight="@dimen/bubble_pad_h"
        android:paddingTop="@dimen/bubble_pad_top"
        android:paddingBottom="@dimen/bubble_pad_bottom">

        <!-- Assistant text is expanded into one child view per Markdown block. -->
        <LinearLayout
            android:id="@+id/bubble_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/bubble_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bubble_time_gap"
            android:singleLine="true"
            android:textColor="@color/chat_time_agent"
            android:textSize="@dimen/text_bubble_time" />
    </LinearLayout>
</LinearLayout>
