<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <!-- The header names the app and, on the right, how far through the
         list you are. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bar_height"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/row_pad_h"
        android:paddingRight="@dimen/row_pad_h">
        <TextView style="@style/FamilyTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" />
        <TextView android:id="@+id/count" style="@style/FamilyTitleMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/page" />
</LinearLayout>
