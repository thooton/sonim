<?xml version="1.0" encoding="utf-8"?>
<!-- The second card's heading: "Completed (n)" and a chevron that folds
     the finished tasks away or opens them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_min_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="8dp">

    <TextView
        android:id="@+id/completed_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/completed_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no" />
</LinearLayout>
