<?xml version="1.0" encoding="utf-8"?>
<!-- The active tab is marked by a solid underline in the on-primary colour,
     drawn as a stroke whose left, top and right edges sit outside the bounds so
     only the bottom edge paints. The bar itself stays a single flat colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:left="-4dp" android:top="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/tab_underline" android:color="@color/on_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
