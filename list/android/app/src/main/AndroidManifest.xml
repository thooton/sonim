<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- One permission. The app sends chat messages and the list to Claude
         over HTTPS; it needs nothing else, and in particular no storage
         permission, because everything it keeps is in its own private
         directory. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Cleartext is off: the only hosts this app talks to are Anthropic's,
         over https, and turning this off means nothing can quietly send the
         login in the clear. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
