<?xml version="1.0" encoding="utf-8"?>
<!-- The Update or Install pill on a row that wants one: outlined in the
     accent, and filled once its row is the focused one, since OK on that row
     opens the menu that does it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_rule" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/focus_rule" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
