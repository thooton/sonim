<?xml version="1.0" encoding="utf-8"?>
<!-- The App Store's capsule: blue capitals on pale grey. On the row under the
     d-pad it fills blue, as the button does while it is pressed, since OK
     there does what it says. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/blue" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pill" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
