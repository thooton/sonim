<?xml version="1.0" encoding="utf-8"?>
<!-- One app: its name, then where it stands ("1.0.0 → 1.1.0", "Up to date ·
     1.1.0", "Downloading 40%"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/row_min_height"
    android:background="@drawable/focus_selector"
    android:clickable="false"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="@dimen/row_pad_h"
    android:paddingRight="@dimen/row_pad_h"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/app_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="@dimen/text_name" />

    <TextView
        android:id="@+id/app_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_status" />
</LinearLayout>
