<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The App Store's own colours (see DESIGN.md, "Updater: as the App
         Store shows it"): a near-white bar with a grey hairline under it,
         white rows, black names, iOS's secondary grey, and its system blue
         for everything that can be pressed. The status bar is the bar's own
         colour, with dark icons. -->
    <color name="bar">#F9F9F9</color>
    <color name="bar_rule">#B2B2B2</color>
    <color name="blue">#007AFF</color>
    <!-- The grey capsule behind UPDATE, OPEN and GET. -->
    <color name="pill">#EFEFF4</color>
    <color name="ring_track">#D1D1D6</color>
    <color name="separator">#C8C7CC</color>

    <!-- What common/ui reads. -->
    <color name="primary">#F9F9F9</color>
    <color name="primary_dark">#F9F9F9</color>
    <color name="on_primary">#000000</color>
    <color name="on_primary_dim">#8E8E93</color>

    <color name="page">#FFFFFF</color>
    <color name="row">#FFFFFF</color>
    <color name="divider">#C8C7CC</color>
    <color name="field_fill">#EFEFF4</color>

    <!-- The row under the d-pad, in iOS's cell-selection grey. -->
    <color name="focus_fill">#E9E9EE</color>
    <color name="focus_rule">#007AFF</color>
    <color name="press_fill">#D9D9DE</color>
    <color name="highlight">#22007AFF</color>

    <color name="text">#000000</color>
    <color name="text_muted">#8E8E93</color>
</resources>
