<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Reads the latest release on GitHub and downloads its APKs. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only for the system installer, used when Installer isn't on the
         phone. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets the Updater hand an APK to Installer (../installer), which
         installs without the XP3's whitelist-gated installer screen. Granted
         only because both apps carry the shared signing key. -->
    <uses-permission android:name="com.installer.xp3.permission.INSTALL" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Cleartext is off: GitHub is https, and nothing else is fetched. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves a downloaded APK, read-only, to the installer through a
             one-off grant. file:// URIs are refused from targetSdk 24, and
             FileProvider would mean a library. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.updater.xp3.apks"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
