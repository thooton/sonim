<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <!-- What OK will fetch, as tabs: left and right move between them while
         the box is empty. They take no focus; the box keeps it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bar_height"
        android:background="@color/primary"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <TextView android:id="@+id/tab_song" style="@style/FamilyTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="false" android:text="@string/tab_song" />
        <TextView android:id="@+id/tab_album" style="@style/FamilyTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="false" android:text="@string/tab_album" />
        <TextView android:id="@+id/tab_book" style="@style/FamilyTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:focusable="false" android:text="@string/tab_book" />
    </LinearLayout>

    <!-- A soft field rather than a framed box: its text starts on the same
         10dp edge as everything below it. -->
    <EditText
        android:id="@+id/query"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/family_field"
        android:imeOptions="actionGo|flagNoExtractUi"
        android:inputType="textCapWords"
        android:maxLines="2"
        android:minHeight="30dp"
        android:paddingBottom="6dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="6dp"
        android:textColor="@color/text"
        android:textColorHint="@color/input_hint"
        android:textSize="@dimen/text_input" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingBottom="4dp"
        android:paddingLeft="@dimen/pad_h"
        android:paddingRight="@dimen/pad_h"
        android:paddingTop="7dp"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_status" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp">

        <!-- Nothing yet: what this tab finds and how. -->
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="5dp"
            android:paddingBottom="24dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:visibility="gone" />

        <!-- The command center's log, as it streams: set small in a
             monospace face, so it reads as a record rather than as the
             screen's content. -->
        <ScrollView
        android:defaultFocusHighlightEnabled="false"
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/row"
            android:focusable="false"
            android:scrollbarStyle="outsideOverlay">
            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:paddingBottom="6dp"
                android:paddingLeft="@dimen/pad_h"
                android:paddingRight="@dimen/pad_h"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_log" />
        </ScrollView>

        <!-- Search results, songs, albums or books, in place of the log. The
             focus card is drawn by the adapter, since the typing box keeps
             the focus. -->
        <ListView
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
