<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <!-- What OK will fetch, as pill tabs in a tonal track, each with the icon
         of what it finds beside its name (built in code). They take no focus;
         the box keeps it, and Left and Right move between them. -->
    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tabs_height"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/tab_track"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="3dp" />

    <!-- The search pill: a ring while it takes the keys. -->
    <LinearLayout
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_height"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/search_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="11dp"
        android:paddingRight="5dp">
        <ImageView
            android:id="@+id/search_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            android:tint="@color/text_muted" />
        <EditText
            android:id="@+id/query"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:paddingLeft="7dp"
            android:paddingRight="0dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_muted"
            android:textSize="@dimen/text_input" />
        <!-- There while there is something typed, which the clear key takes back. -->
        <ImageView
            android:id="@+id/search_clear"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:padding="4.5dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_muted"
            android:visibility="gone" />
    </LinearLayout>

    <!-- How things stand: a spinner while a search runs, the status line,
         and on the right what the options are set to. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp"
        android:paddingLeft="12dp"
        android:paddingRight="8dp"
        android:paddingTop="7dp">
        <ProgressBar
            android:id="@+id/spinner"
            style="@android:style/Widget.Material.ProgressBar.Small"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="6dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:fontFamily="@font/dm_sans_medium"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_status" />
        <TextView
            android:id="@+id/chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip"
            android:drawablePadding="3dp"
            android:includeFontPadding="false"
            android:paddingBottom="2dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:singleLine="true"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp">

        <!-- Before a search: what is downloading, recent searches, and the
             storage card. Built in code. -->
        <ScrollView
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="false"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/home_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="6dp" />
        </ScrollView>

        <!-- The command center's log, as it streams: Soulseek's engine as it
             is, set small in a monospace face on a card, so it reads as a
             record rather than as the screen's content. -->
        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="false"
            android:scrollbarStyle="outsideOverlay"
            android:visibility="gone">
            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:layout_marginLeft="@dimen/gutter"
                android:layout_marginRight="@dimen/gutter"
                android:background="@drawable/log_card"
                android:focusable="false"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="8dp"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_log" />
        </ScrollView>

        <!-- Songs, albums or books. Rows paint their own focus, since the
             typing box keeps the focus. -->
        <ListView
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:focusable="false"
            android:scrollbarStyle="outsideOverlay"
            android:visibility="gone" />

        <!-- Nothing found, or the search failed: what is so, and a next
             step, which takes the d-pad. Built in code. -->
        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="10dp"
            android:visibility="gone" />

        <!-- A book search on its way: rows the shape of results. -->
        <LinearLayout
            android:id="@+id/skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/softkeys" />
</LinearLayout>
