<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light chrome: the status bar is the page's own colour, with dark
         icons; values-night turns both round. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlHighlight">@color/highlight</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/SourceDialog</item>
        <item name="android:popupMenuStyle">@style/FamilyPopupMenu</item>
        <item name="android:contextPopupMenuStyle">@style/FamilyPopupMenu</item>
    </style>

    <style name="SourceDialog" parent="FamilyDialog" />

    <!-- A pill tab in the tabs' track. -->
    <style name="Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/tab_pill</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:focusable">false</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- The options sheet: a window at the foot of the screen over a scrim. -->
    <style name="Sheet" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.38</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorControlHighlight">@color/highlight</item>
    </style>
</resources>
