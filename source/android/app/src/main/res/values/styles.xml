<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light chrome: the status bar is the page's own colour, with dark
         icons; values-night turns both round. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/dm_sans_family</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlHighlight">@color/highlight</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/SourceDialog</item>
        <item name="android:popupMenuStyle">@style/FamilyPopupMenu</item>
        <item name="android:contextPopupMenuStyle">@style/FamilyPopupMenu</item>
    </style>

    <style name="SourceDialog" parent="FamilyDialog">
        <item name="android:fontFamily">@font/dm_sans_family</item>
    </style>


    <!-- The options sheet: a window at the foot of the screen over a scrim. -->
    <style name="Sheet" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.38</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorControlHighlight">@color/highlight</item>
        <item name="android:fontFamily">@font/dm_sans_family</item>
    </style>
</resources>
