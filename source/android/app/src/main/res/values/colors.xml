<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tonal (DESIGN.md, "Source: Tonal"): Material 3's colour roles from
         the seed #6750A4, light here and dark in values-night. The family's
         names (primary, row, focus_fill...) are kept for what the shared
         drawables and dialogs draw with, pointed at the matching role. -->

    <!-- surface, and the containers on it, lowest to highest. -->
    <color name="page">#FEF7FF</color>
    <color name="container">#F3EDF7</color>
    <color name="container_high">#ECE6F0</color>
    <color name="container_highest">#E6E0E9</color>
    <!-- onSurface, onSurfaceVariant, outline and outlineVariant. -->
    <color name="text">#1D1B20</color>
    <color name="text_muted">#49454F</color>
    <color name="outline">#79747E</color>
    <color name="outline_variant">#CAC4D0</color>

    <!-- primary and primaryContainer: the one key action, progress and focus
         rings; the focused row, the picked tab and tonal buttons. -->
    <color name="accent">#6750A4</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="accent_container">#EADDFF</color>
    <color name="on_accent_container">#21005D</color>
    <!-- What is left of a progress bar or ring. -->
    <color name="track">#E0D7EC</color>

    <!-- tertiaryContainer, for format tags. -->
    <color name="tag">#FFD8E4</color>
    <color name="on_tag">#31111D</color>

    <!-- tertiary: the Books share of the storage bar. -->
    <color name="tertiary">#7D5260</color>

    <!-- Saved, and failed. -->
    <color name="success">#2E7D4F</color>
    <color name="success_container">#C4EED0</color>
    <color name="on_success_container">#0F5223</color>
    <color name="error">#B3261E</color>
    <color name="error_container">#F9DEDC</color>
    <color name="on_error_container">#410E0B</color>

    <!-- Drawn covers: a container tone and the ink of its initials. -->
    <color name="cover_1">#EADDFF</color>
    <color name="cover_1_ink">#21005D</color>
    <color name="cover_2">#FFD8E4</color>
    <color name="cover_2_ink">#31111D</color>
    <color name="cover_3">#C4EED0</color>
    <color name="cover_3_ink">#0F5223</color>
    <color name="cover_4">#D6E3FF</color>
    <color name="cover_4_ink">#001B3E</color>
    <color name="cover_5">#FFDDB3</color>
    <color name="cover_5_ink">#2A1800</color>
    <color name="cover_6">#BCEBF0</color>
    <color name="cover_6_ink">#002022</color>

    <!-- The family's names. -->
    <color name="primary">#FEF7FF</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#49454F</color>
    <color name="row">#FEF7FF</color>
    <color name="section_fill">#F3EDF7</color>
    <color name="divider">#E6E0E9</color>
    <color name="field_fill">#ECE6F0</color>
    <color name="code_fill">#ECE6F0</color>
    <color name="focus_fill">#EADDFF</color>
    <color name="focus_rule">#6750A4</color>
    <color name="press_fill">#EADDFF</color>
    <!-- The platform's highlight (a stock menu's item under the d-pad, a
         press): the accent, faint enough that what it covers stays legible. -->
    <color name="highlight">#246750A4</color>
</resources>
