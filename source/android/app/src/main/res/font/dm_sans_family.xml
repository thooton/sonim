<?xml version="1.0" encoding="utf-8"?>
<!-- DM Sans, the Tonal proposal's face: its open shapes and large x-height
     stay readable at 10 to 12px on the XP3's low-density screen. Static
     instances of Google Fonts' variable DM Sans (google/fonts, ofl/dmsans,
     SIL Open Font License 1.1) at its 14pt optical size, in the four weights
     the proposal uses. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/dm_sans" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/dm_sans_medium" android:fontStyle="normal" android:fontWeight="500" />
    <font android:font="@font/dm_sans_semibold" android:fontStyle="normal" android:fontWeight="600" />
    <font android:font="@font/dm_sans_bold" android:fontStyle="normal" android:fontWeight="700" />
</font-family>
