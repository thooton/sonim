<?xml version="1.0" encoding="utf-8"?>
<!-- The search pill: surfaceContainerHigh at rest, the page with a 2dp
     primary ring while it takes the keys (activated, since the box keeps the
     focus even while the d-pad moves through the rows below it). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/page" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/container_high" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
