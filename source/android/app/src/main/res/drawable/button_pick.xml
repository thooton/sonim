<?xml version="1.0" encoding="utf-8"?>
<!-- An empty state's next step: tonal, and with a primary ring when picked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_container" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/container_high" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
