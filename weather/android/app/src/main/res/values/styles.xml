<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black under the sky, as CARROT's dark mode is; the sky takes the
         status bar's colour itself as the forecast comes. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimaryDark">#0077F8</item>
        <item name="android:statusBarColor">#0077F8</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:colorAccent">#0B84FE</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
