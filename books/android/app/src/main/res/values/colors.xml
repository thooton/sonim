<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Apple Books in dark mode: true black behind everything, iOS's dark
         greys for raised surfaces, and Books' orange as the one accent. -->
    <color name="page">#000000</color>
    <color name="surface">#1C1C1E</color>
    <color name="surface_raised">#2C2C2E</color>
    <color name="separator">#38383A</color>
    <color name="hairline">#1F1F21</color>

    <color name="label">#FFFFFF</color>
    <color name="label_secondary">#8E8E93</color>
    <color name="label_tertiary">#5A5A5E</color>
    <color name="accent">#FF9F0A</color>
    <color name="switch_off">#39393D</color>

    <!-- The page. Text is a soft white rather than pure white, which glares
         on a small LCD in the dark. Night Shift has no colours of its own:
         it warms the whole screen through a filter (see NightShift). -->
    <color name="text_day">#E3E3E5</color>
    <color name="text_day_dim">#7C7C80</color>
</resources>
